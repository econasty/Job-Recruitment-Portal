# Copy to .env and fill in. Never commit .env.
PORT=3000
# The public URL of your site. Must match the redirect URIs you register below.
BASE_URL=http://localhost:3000
TRUST_PROXY=1
# Google: https://console.cloud.google.com/apis/credentials  (OAuth client ID, type "Web application")
#   Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=1009288508440-jho726utjq3hhqfmtsokcea259iag5ds.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# LinkedIn: https://www.linkedin.com/developers/apps  (add the "Sign In with LinkedIn using OpenID Connect" product)
#   Authorized redirect URL: <BASE_URL>/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional: database file location (default: ./linkedout.db)
# DB_FILE=linkedout.db
